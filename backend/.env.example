ENVIRONMENT=development
DEBUG=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
# LLM provider (chat only): "ollama" for local dev (default), "groq" for deployment.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
# Only needed when LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Embedding provider (independent of LLM_PROVIDER): "ollama" for local dev
# (default), "google" for deployment. See README for why this is a separate axis.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe:latest
OLLAMA_EMBED_DIMENSIONS=768
# Only needed when EMBEDDING_PROVIDER=google
GOOGLE_API_KEY=your-google-api-key
GOOGLE_EMBED_MODEL=models/gemini-embedding-001
GOOGLE_EMBED_DIMENSIONS=768

# Graph RAG retrieval — how many entities seed a search, how many hops the
# graph expansion walks, and how many entities the context block is capped at.
RAG_SEED_TOP_K=8
RAG_EXPAND_DEPTH=1
RAG_MAX_CONTEXT_ENTITIES=30

CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET_KEY=your-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Give each new account its own copy of the starter world at registration.
SEED_NEW_USER_WORLD=true